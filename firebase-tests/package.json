{
  "name": "tock-firebase-tests",
  "private": true,
  "description": "Solo test delle regole Firebase sull'emulatore locale. NON fa parte del gioco.",
  "scripts": {
    "test": "firebase emulators:exec --only database,auth --project demo-tock \"node --test --test-force-exit --test-concurrency=1 test/*.test.js\"",
    "controlla-sito": "node controlla-sito.js",
    "fase0-prova": "firebase emulators:exec --only database --project demo-tock \"node --test --test-force-exit fase0/prova-ripristino.test.js\"",
    "fase2-prova": "firebase emulators:exec --only database --project demo-tock \"node --test --test-force-exit fase2/prova-fase2.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.35.1",
    "playwright": "1.56.1"
  }
}
